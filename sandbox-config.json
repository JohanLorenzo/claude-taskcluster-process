{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "docker *",
      "gh *",
      "git fetch*",
      "git pull*",
      "git push*",
      "pre-commit run *",
      "stmo-cli *",
      "*/stmo-cli *",
      "taskcluster *"
    ],
    "filesystem": {
      "allowWrite": ["~/.cache", "~/.mozbuild"],
      "denyWrite": [
        "~/.ssh",
        "~/.bashrc",
        "~/.zshrc",
        "~/.profile",
        "~/.bash_profile",
        "~/.config/taskcluster.yml"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "firefox-ci-tc.services.mozilla.com",
        "stage.taskcluster.nonprod.webservices.mozgcp.net",
        "pypi.org",
        "files.pythonhosted.org",
        "bugzilla.mozilla.org",
        "lando.moz.tools",
        "www.googleapis.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "mozilla-hub.atlassian.net",
        "api.lando.services.mozilla.com",
        "code.claude.com"
      ]
    }
  }
}
